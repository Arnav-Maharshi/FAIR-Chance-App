{
  "appId": "com.fairchance.app",
  "appName": "FAIR Chance",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "https://cdn.jsdelivr.net",
      "https://storage.googleapis.com"
    ]
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera"]
    },
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "android": {
    "permissions": [
      "android.permission.CAMERA"
    ]
  },
  "ios": {
    "permissions": [
      "NSCameraUsageDescription: This app needs camera access for hand tracking rehabilitation exercises."
    ]
  }
}